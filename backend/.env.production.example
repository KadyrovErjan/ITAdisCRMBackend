# ===================================
# ITAdis CRM - Production Environment (Hetzner + Cloudflare)
# ===================================

# Django Settings
SECRET_KEY=CHANGE-THIS-TO-RANDOM-SECRET-KEY
DEBUG=False
ALLOWED_HOSTS=api.itadiscrm.com.kg,2.29.61.103

# Database Configuration (Docker PostgreSQL)
DB_NAME=itadis_db
DB_USER=itadis_user
DB_PASSWORD=CHANGE-THIS-TO-SECURE-PASSWORD
DB_HOST=db
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://itadiscrm.com.kg,https://www.itadiscrm.com.kg
CSRF_TRUSTED_ORIGINS=https://api.itadiscrm.com.kg,https://itadiscrm.com.kg,https://www.itadiscrm.com.kg

# API Base URL (для Swagger документации)
API_BASE_URL=https://api.itadiscrm.com.kg

# Nginx terminates TLS at the origin and forwards the HTTPS scheme to Django.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Email Configuration (опционально)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ===================================
# Генерация SECRET_KEY:
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ===================================
